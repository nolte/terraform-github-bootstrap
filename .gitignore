# Vale: `vale sync` writes the downloaded style packages into .github/styles/,
# so the directory stays ignored -- except this repository's own vocabulary,
# which is source and has to be tracked.
.github/styles/*
!.github/styles/.keep
!.github/styles/config
.github/styles/config/*
!.github/styles/config/vocabularies
.github/styles/config/vocabularies/*
!.github/styles/config/vocabularies/terraform-github-bootstrap
